---
interface Props {
  t: {
    wordmark: string
    career: string
    work: string
    about: string
    stack: string
    contact: string
    switchLang: string
  }
  switchHref: string
}
const { t, switchHref } = Astro.props

const links = [
  { href: '#career', label: t.career },
  { href: '#work', label: t.work },
  { href: '#about', label: t.about },
  { href: '#stack', label: t.stack },
]
---

<nav class="bg-panel border-b border-line sticky top-0 z-20">
  <div class="max-w-[1040px] mx-auto px-5 sm:px-8 flex items-center justify-between h-[68px]">
    <a class="font-display font-bold text-[21px] text-ink no-underline" href="#top">{t.wordmark}</a>
    <div class="flex gap-[26px] items-center">
      {links.map(l => (
        <a
          class="text-[14.5px] text-ink-soft no-underline hover:text-ink max-[679px]:hidden"
          href={l.href}
        >
          {l.label}
        </a>
      ))}
      <a
        class="text-[14.5px] text-ink-soft no-underline hover:text-ink max-[679px]:hidden"
        href={switchHref}
      >
        {t.switchLang}
      </a>
      <a
        class="text-[14.5px] text-ink no-underline border-b-2 border-ink pb-[2px]"
        href="#contact"
      >
        {t.contact}
      </a>
    </div>
  </div>
</nav>
