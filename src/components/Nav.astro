---
interface Props {
  t: {
    wordmark: string
    career: string
    work: string
    about: string
    stack: string
    contact: string
  }
  locale: 'en' | 'pt-BR'
  switchHref: string
}
const { t, locale, switchHref } = Astro.props
const isPT = locale === 'pt-BR'

const links = [
  { href: '#career', label: t.career },
  { href: '#work', label: t.work },
  { href: '#about', label: t.about },
  { href: '#stack', label: t.stack },
]
---

<nav class="bg-panel border-b border-line sticky top-0 z-20">
  <div class="max-w-[1040px] mx-auto px-5 sm:px-8 flex items-center justify-between h-[68px]">
    <a class="font-display font-bold text-[21px] text-ink no-underline" href="#top">{t.wordmark}</a>
    <div class="flex gap-[18px] items-center">
      {links.map(l => (
        <a
          class="text-[14.5px] text-ink-soft no-underline hover:text-ink max-[679px]:hidden"
          href={l.href}
        >
          {l.label}
        </a>
      ))}

      <a
        href={switchHref}
        aria-label={isPT ? 'Switch to English' : 'Mudar para Português'}
        class="inline-flex items-center gap-[3px] rounded-full border border-line bg-panel-deep p-[3px] no-underline"
      >
        <span class:list={[
          'inline-flex items-center gap-1 rounded-full px-[10px] py-[3px] text-xs font-semibold',
          !isPT ? 'bg-ink text-panel' : 'text-ink-soft',
        ]}>
          <span aria-hidden="true">🌐</span>EN
        </span>
        <span class:list={[
          'inline-flex items-center gap-1 rounded-full px-[10px] py-[3px] text-xs font-semibold',
          isPT ? 'bg-ink text-panel' : 'text-ink-soft',
        ]}>
          <span aria-hidden="true">🇧🇷</span>PT
        </span>
      </a>

      <span class="w-px h-4 bg-line" aria-hidden="true"></span>

      <a
        class="text-[14.5px] text-ink no-underline border-b-2 border-ink pb-[2px]"
        href="#contact"
      >
        {t.contact}
      </a>
    </div>
  </div>
</nav>
