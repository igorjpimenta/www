---
interface Props {
  t: {
    heading: string
    paragraphs: string[]
    statement: string
  }
}
const { t } = Astro.props
---

<section class="border-t border-line py-20" id="about">
  <div class="max-w-[1040px] mx-auto px-5 sm:px-8">
    <h2 class="text-[clamp(28px,3.6vw,38px)] max-w-[20ch]">{t.heading}</h2>

    <div class="space-y-4 mt-[22px]">
      {t.paragraphs.map(p => (
        <p class="text-[17px] leading-[1.7] text-ink-soft max-w-[62ch]">{p}</p>
      ))}
    </div>

    <div class="font-display font-bold text-[clamp(24px,3vw,32px)] leading-[1.2] max-w-[22ch] text-ink mt-8 pt-7 border-t-2 border-ink">
      {t.statement}
    </div>
  </div>
</section>
