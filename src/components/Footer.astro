---
interface Props {
  t: {
    heading: string
    body: string
    reachMe: string
    elsewhere: string
    nyxenLink: string
    bottomLeft: string
    bottomRight: string
  }
}
const { t } = Astro.props
---

<footer class="bg-ink text-panel py-16 pb-9" id="contact">
  <div class="max-w-[1040px] mx-auto px-5 sm:px-8">
    <div class="grid grid-cols-1 min-[701px]:grid-cols-[1.3fr_1fr_1fr] gap-10">
      <div>
        <h2 class="text-[clamp(26px,3vw,32px)] text-panel">{t.heading}</h2>
        <p class="text-[17px] leading-[1.7] text-[#b9b6a9] max-w-[62ch] mt-[22px]">
          {t.body}
        </p>
      </div>
      <div>
        <h5 class="text-[13px] text-[#b9b6a9] font-semibold mb-3">{t.reachMe}</h5>
        <a class="block text-[15px] text-panel no-underline py-[5px] hover:text-brass hover:underline" href="mailto:pimenta@nyxen.ai">pimenta@nyxen.ai</a>
        <a class="block text-[15px] text-panel no-underline py-[5px] hover:text-brass hover:underline" href="https://linkedin.com/in/igor-pimenta" target="_blank" rel="noopener">LinkedIn</a>
        <a class="block text-[15px] text-panel no-underline py-[5px] hover:text-brass hover:underline" href="https://github.com/igorjpimenta" target="_blank" rel="noopener">GitHub</a>
      </div>
      <div>
        <h5 class="text-[13px] text-[#b9b6a9] font-semibold mb-3">{t.elsewhere}</h5>
        <a class="block text-[15px] text-panel no-underline py-[5px] hover:text-brass hover:underline" href="https://nyxen.ai" target="_blank" rel="noopener">{t.nyxenLink}</a>
      </div>
    </div>
    <div class="mt-[52px] pt-6 border-t border-[#3a382e] text-[13px] text-[#948f80] flex justify-between flex-wrap gap-2.5">
      <span>{t.bottomLeft}</span>
      <span>{t.bottomRight}</span>
    </div>
  </div>
</footer>
