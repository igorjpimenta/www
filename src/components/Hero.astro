---
import Reading from './Reading.astro'
---

<header class="pt-[76px] pb-[90px]" id="top">
  <div class="max-w-[1040px] mx-auto px-5 sm:px-8">
    <div class="grid grid-cols-1 min-[761px]:grid-cols-[1fr_auto] gap-6 items-start">
      <h1 class="text-[clamp(36px,5.4vw,58px)] leading-[1.04] max-w-[16ch]">
        Ten years finding where a business was leaking money and time, then building the fix.
      </h1>
      <span class="text-sm text-ink-soft whitespace-nowrap">Belo Horizonte, Brazil (GMT-3)</span>
    </div>

    <p class="text-lg leading-[1.7] text-ink-soft max-w-[52ch] mt-[26px]">
      AI engineer and technical product manager. I scope it, build it, and ship it
      myself. Most recently, a WhatsApp agent recovering roughly R$4M a day (about US$750,000)
      for a client that didn't know it was losing that much to a slow manual process.
    </p>

    <div class="flex gap-5 items-center flex-wrap mt-[34px]">
      <a
        class="font-sans text-[15px] font-semibold px-[22px] py-[13px] no-underline inline-block border-[1.5px] border-ink bg-ink text-panel hover:bg-[#3a382e]"
        href="#work"
      >
        See the case studies
      </a>
      <a
        class="font-sans text-[15px] font-semibold px-[22px] py-[13px] no-underline inline-block border-[1.5px] border-ink text-ink hover:bg-panel-deep"
        href="#contact"
      >
        Get in touch
      </a>
    </div>

    <Reading
      pos="88%"
      left="Before: agents queried invoices and sent barcodes by hand, one customer at a time."
      right="R$4M/day recovered, fully automated"
    />
  </div>
</header>
