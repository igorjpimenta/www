---
interface Group {
  title: string
  rows: string[][]
}
interface Props {
  t: {
    heading: string
    groups: Group[]
  }
}
const { t } = Astro.props
---

<section class="border-t border-line bg-panel-deep py-20" id="stack">
  <div class="max-w-[1040px] mx-auto px-5 sm:px-8">
    <h2 class="text-[clamp(28px,3.6vw,38px)] max-w-[20ch]">{t.heading}</h2>

    <div class="mt-12 flex flex-col gap-11">
      {t.groups.map(g => (
        <div>
          <h4 class="font-sans font-bold text-base mb-1.5">{g.title}</h4>
          <table class="w-full border-collapse">
            <tbody>
              {g.rows.map(([skill, evidence]) => (
                <tr class="border-t border-line">
                  <td class="py-[13px] text-[14.5px] text-ink font-semibold w-[46%]">{skill}</td>
                  <td class="py-[13px] text-[14.5px] text-ink-soft text-right">{evidence}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}
    </div>
  </div>
</section>
