---
interface Role {
  years: string
  title: string
  body: string
  result: string
  current: boolean
}
interface Props {
  t: {
    heading: string
    roles: Role[]
  }
}
const { t } = Astro.props
---

<section class="border-t border-line py-20" id="career">
  <div class="max-w-[1040px] mx-auto px-5 sm:px-8">
    <h2 class="text-[clamp(28px,3.6vw,38px)] max-w-[20ch]">{t.heading}</h2>

    <div class="mt-[52px] border-l-2 border-ink ml-[6px] pl-[34px] flex flex-col gap-11">
      {t.roles.map(r => (
        <div class="relative">
          <span
            class:list={[
              'absolute -left-[42px] top-[5px] w-[13px] h-[13px] rounded-full border-2',
              r.current ? 'bg-brass border-brass' : 'bg-panel border-ink',
            ]}
          />
          <div class="text-[13.5px] text-ink-soft mb-1">{r.years}</div>
          <h3 class="font-sans font-bold text-[19px] leading-[1.3]">{r.title}</h3>
          <p class="text-[15px] leading-[1.65] text-ink-soft mt-2 max-w-[58ch]">{r.body}</p>
          <div class="text-[14.5px] text-verdant font-semibold mt-[10px]">{r.result}</div>
        </div>
      ))}
    </div>
  </div>
</section>
