---
interface Props {
  t: {
    heading: string
    bodyPrefix: string
    bodySuffix: string
    linkLabel: string
    cta: string
  }
}
const { t } = Astro.props
---

<section class="border-t border-line py-20">
  <div class="max-w-[1040px] mx-auto px-5 sm:px-8">
    <h2 class="text-[clamp(28px,3.6vw,38px)] max-w-[20ch]">{t.heading}</h2>
    <div class="mt-12 p-8 bg-panel-deep flex flex-col gap-5 items-start">
      <p class="text-[15.5px] leading-[1.7] text-ink-soft max-w-[60ch]">
        {t.bodyPrefix}{' '}
        <a
          class="text-ink underline underline-offset-[3px]"
          href="https://nyxen.ai"
          target="_blank"
          rel="noopener"
        >
          {t.linkLabel}
        </a>{t.bodySuffix}
      </p>
      <a
        class="font-sans text-[15px] font-semibold px-[22px] py-[13px] no-underline inline-block border-[1.5px] border-brass bg-brass text-panel hover:bg-brass-deep"
        href="https://nyxen.ai"
        target="_blank"
        rel="noopener"
      >
        {t.cta}
      </a>
    </div>
  </div>
</section>
